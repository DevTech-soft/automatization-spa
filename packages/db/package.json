{
  "name": "@spa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema Prisma, migraciones y tipos de datos compartidos del sistema spa",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "prisma"],
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../apps/backend/.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "dotenv -e ../../apps/backend/.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../apps/backend/.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.1"
  }
}
