# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Bogota
LOG_LEVEL=info

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Business Cloud API (Meta, ver Fase 6 / docs/WHATSAPP.md) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token propio (inventado por ti) para el handshake GET del webhook con Meta.
WHATSAPP_VERIFY_TOKEN=
# App secret de Meta, valida la firma X-Hub-Signature-256 de los webhooks
# entrantes. Sin esta variable el webhook sigue funcionando pero sin validar
# firma — no usar así en producción.
WHATSAPP_APP_SECRET=

# --- Payments (Wompi, ver Fase 4 / docs/PAYMENTS.md) ---
# wompi | mercadopago (mercadopago no está implementado todavía)
PAYMENT_PROVIDER=wompi
# Llave privada/integración de Wompi (prv_test_... / prv_prod_...). No se usa
# todavía para llamadas server-to-server, se guarda para uso futuro.
PAYMENT_API_KEY=
# Llave pública de Wompi (pub_test_... / pub_prod_...), va en la URL del checkout.
PAYMENT_PUBLIC_KEY=
# Secreto de integridad de Wompi, firma el checkout (Eventos > Integridad).
PAYMENT_INTEGRITY_SECRET=
# Secreto de eventos de Wompi, valida la firma de los webhooks entrantes.
PAYMENT_WEBHOOK_SECRET=

# --- Google Sheets (ver Fase 7 / docs/GOOGLE-SHEETS.md) ---
# Service Account (no OAuth): crea una en Google Cloud Console, comparte el
# Sheet con este email como editor. No requiere login ni refresh token.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada del JSON de la Service Account, tal cual (con \n literales
# o saltos de línea reales, ambos formatos se soportan).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# El ID del spreadsheet (de su URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=

# --- Storage (Supabase Storage, ver Fase 8 / docs/GIFT-CARDS.md) ---
# Nombre del bucket donde se suben las imágenes de Gift Cards. Se crea
# automáticamente como público en el primer upload si no existe.
STORAGE_BUCKET=gift-cards

# --- Cifrado de secretos por-tenant (ver docs/PANEL-OPERADOR.md §9) ---
# Clave maestra AES-256 para cifrar tokens de WhatsApp y llaves de Wompi por
# negocio en reposo. Base64 de 32 bytes: openssl rand -base64 32
# Opcional hasta que F2/F4 empiecen a guardar credenciales por negocio.
SECRETS_ENCRYPTION_KEY=

# --- Protección de canje de Gift Cards (ver Fase 0 sección 7 / Fase 8 / docs/GIFT-CARDS.md) ---
# PIN compartido de staff para POST /api/gift-cards/redeem (vía /validar). Sin
# esta variable el canje se rechaza siempre (falla cerrado, no abierto).
STAFF_PIN=

# --- Internal jobs (scheduler in-process -> backend, ver Fase 3/9) ---
# Token compartido de al menos 16 caracteres, ej: openssl rand -hex 32
INTERNAL_JOBS_TOKEN=

# --- Agente conversacional en n8n (ver docs/AGENTE-N8N.md) ---
# Webhook del workflow del agente. Vacío = todos los negocios usan el bot
# determinístico de menús. En Railway usa la red privada del proyecto:
# http://n8n.railway.internal:5678/webhook/agente-reservas
N8N_AGENT_WEBHOOK_URL=
# Secreto compartido con n8n en ambos sentidos: viaja en X-Agent-Token al
# reenviar el mensaje, y n8n lo devuelve como Bearer en /internal/agent/*.
# Si se deja vacío, esas rutas exigen INTERNAL_JOBS_TOKEN.
N8N_AGENT_TOKEN=
# Cuánto se espera a n8n antes de caer al bot de menús (ms).
N8N_AGENT_TIMEOUT_MS=20000
