{
  "name": "spa-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @spa/db generate",
    "db:migrate": "pnpm --filter @spa/db migrate:dev",
    "db:deploy": "pnpm --filter @spa/db migrate:deploy",
    "db:seed": "pnpm --filter @spa/db seed",
    "db:studio": "pnpm --filter @spa/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
