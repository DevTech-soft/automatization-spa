// Modelo de datos del MVP — ver docs/ARCHITECTURE.md para las decisiones de Fase 0.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum AppointmentSource {
  WEB
  WHATSAPP
  GIFT_CARD
}

enum PaymentEntityType {
  APPOINTMENT
  GIFT_CARD
}

enum GiftCardStatus {
  PENDING
  PAID
  SENT
  REDEEMED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  BUSINESS_NEW_APPOINTMENT
  GIFT_CARD_DELIVERY
  BUSINESS_NEW_GIFT_CARD
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

model Business {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  phone          String?
  whatsappNumber String?  @map("whatsapp_number")
  email          String?
  address        String?
  logoUrl        String?  @map("logo_url")
  timezone       String   @default("America/Bogota")
  currency       String   @default("COP")
  /// Config flexible: gift_card_validity_days, reminder_hours_before, etc.
  settings       Json     @default("{}")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  services         Service[]
  businessHours    BusinessHour[]
  customers        Customer[]
  appointments     Appointment[]
  payments         Payment[]
  giftCards        GiftCard[]
  notificationLogs NotificationLog[]

  @@map("businesses")
}

model Service {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @map("duration_minutes")
  /// Citas simultáneas permitidas para este servicio (ej. 3 sillas de manicure). Ver Fase 0.
  capacity        Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  giftCards    GiftCard[]

  @@index([businessId])
  @@map("services")
}

model BusinessHour {
  id         String  @id @default(uuid())
  businessId String  @map("business_id")
  /// 0 = domingo ... 6 = sábado
  dayOfWeek  Int     @map("day_of_week")
  openTime   String  @map("open_time")
  closeTime  String  @map("close_time")
  active     Boolean @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_hours")
}

model Customer {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  phone      String
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@map("customers")
}

model Appointment {
  id              String            @id @default(uuid())
  businessId      String            @map("business_id")
  customerId      String            @map("customer_id")
  serviceId       String            @map("service_id")
  appointmentCode String            @map("appointment_code")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  /// Hora local del negocio en formato "HH:mm"
  startTime       String            @map("start_time")
  endTime         String            @map("end_time")
  price           Decimal           @db.Decimal(12, 2)
  status          AppointmentStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING) @map("payment_status")
  paymentReference String?          @map("payment_reference")
  source          AppointmentSource
  notes           String?
  expiresAt       DateTime?         @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([businessId, appointmentCode])
  @@index([businessId])
  @@index([appointmentDate])
  @@index([paymentReference])
  @@index([businessId, serviceId, appointmentDate])
  @@map("appointments")
}

model Payment {
  id            String            @id @default(uuid())
  businessId    String            @map("business_id")
  reference     String            @unique
  provider      String
  transactionId String?           @map("transaction_id")
  amount        Decimal           @db.Decimal(12, 2)
  currency      String
  status        PaymentStatus     @default(PENDING)
  entityType    PaymentEntityType @map("entity_type")
  entityId      String            @map("entity_id")
  rawResponse   Json?             @map("raw_response")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([entityType, entityId])
  @@map("payments")
}

model GiftCard {
  id               String         @id @default(uuid())
  businessId       String         @map("business_id")
  code             String         @unique
  buyerName        String         @map("buyer_name")
  buyerPhone       String         @map("buyer_phone")
  buyerEmail       String?        @map("buyer_email")
  recipientName    String         @map("recipient_name")
  recipientPhone   String?        @map("recipient_phone")
  recipientEmail   String?        @map("recipient_email")
  serviceId        String?        @map("service_id")
  amount           Decimal        @db.Decimal(12, 2)
  message          String?
  scheduledDate    DateTime?      @map("scheduled_date") @db.Date
  status           GiftCardStatus @default(PENDING)
  paymentStatus    PaymentStatus  @default(PENDING) @map("payment_status")
  paymentReference String?        @map("payment_reference")
  design           String?
  pdfUrl           String?        @map("pdf_url")
  createdAt        DateTime       @default(now()) @map("created_at")
  redeemedAt       DateTime?      @map("redeemed_at")
  expiresAt        DateTime?      @map("expires_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([paymentReference])
  @@map("gift_cards")
}

/// Registro de notificaciones enviadas, usado para garantizar idempotencia
/// (recordatorios, confirmaciones) — ver sección 21 y 32 del prompt maestro.
model NotificationLog {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  entityType String              @map("entity_type")
  entityId   String              @map("entity_id")
  type       NotificationType
  channel    NotificationChannel
  sentAt     DateTime            @default(now()) @map("sent_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, type])
  @@index([businessId])
  @@map("notification_log")
}
