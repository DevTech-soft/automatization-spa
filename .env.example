# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Bogota
LOG_LEVEL=info

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n ---
N8N_WEBHOOK_BASE_URL=

# --- WhatsApp Business Cloud API (Meta, ver Fase 6 / docs/WHATSAPP.md) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token propio (inventado por ti) para el handshake GET del webhook con Meta.
WHATSAPP_VERIFY_TOKEN=
# App secret de Meta, valida la firma X-Hub-Signature-256 de los webhooks
# entrantes. Sin esta variable el webhook sigue funcionando pero sin validar
# firma — no usar así en producción.
WHATSAPP_APP_SECRET=

# --- Payments (Wompi, ver Fase 4 / docs/PAYMENTS.md) ---
# wompi | mercadopago (mercadopago no está implementado todavía)
PAYMENT_PROVIDER=wompi
# Llave privada/integración de Wompi (prv_test_... / prv_prod_...). No se usa
# todavía para llamadas server-to-server, se guarda para uso futuro.
PAYMENT_API_KEY=
# Llave pública de Wompi (pub_test_... / pub_prod_...), va en la URL del checkout.
PAYMENT_PUBLIC_KEY=
# Secreto de integridad de Wompi, firma el checkout (Eventos > Integridad).
PAYMENT_INTEGRITY_SECRET=
# Secreto de eventos de Wompi, valida la firma de los webhooks entrantes.
PAYMENT_WEBHOOK_SECRET=

# --- Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEET_ID=

# --- Storage ---
STORAGE_BUCKET=gift-cards

# --- Staff protection for /validar y /api/gift-cards/redeem (ver Fase 0, sección 7) ---
STAFF_PIN=

# --- Internal jobs (n8n cron -> backend, ver Fase 3) ---
# Token compartido de al menos 16 caracteres, ej: openssl rand -hex 32
INTERNAL_JOBS_TOKEN=
